# Copy to .env and fill in. Nothing here is required until phase 4 (LLM ranking and
# summaries); phases 0-3 run with no secrets at all.

# --- LLM (phase 4) ---
ANTHROPIC_API_KEY=
DIGEST_MODEL=claude-haiku-4-5-20251001

# --- HTTP ---
# A real User-Agent is mandatory: GitHub Trending and Reddit both throttle the defaults.
DIGEST_USER_AGENT="AI-news-digest/0.1 (+personal daily digest; contact: you@example.com)"

# --- Paths ---
# Defaults are relative to the working directory.
DIGEST_DB_PATH=digest.db
DIGEST_OUTPUT_DIR=digests

# --- Delivery (phase 5) ---
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
